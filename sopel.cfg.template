[core]
nick = SpawnKeeper
prefix = !
host = irc.libera.chat
port = 6697
use_ssl = true
verify_ssl = true
channels = #freespawn
extra = /bot/plugins
# Sopels eingebautes "help"-Plugin kollidiert mit unserem eigenen !help
# (beide reagieren auf den Trigger -> doppelte Antwort, einmal im Channel
# von sopel-help, einmal von uns). Deaktiviert, unser spawnkeeper_commands.help_cmd
# deckt das ab.
exclude = help
# SASL statt NickServ-IDENTIFY: der Bot ist schon vor der Registrierung im
# Account eingeloggt, egal unter welchem Nick er gerade läuft. Nur so kann er
# nach einem Reconnect mit belegtem Nick per NickServ REGAIN zurückholen
# (Sopels eigener GHOST-Pfad benennt sich danach nie zurück, siehe
# spawnkeeper_topic.py) und ChanServ gibt direkt beim Join Op.
auth_method = sasl
auth_username = SpawnKeeper
auth_password = ${NICKSERV_PASSWORD}
owner = nicolas
# Logs werden ins data-Volume geschrieben
logdir = /bot/data/logs
pid_dir = /bot/data
