# IRC-Bot Konfiguration
# NickServ-Passwort für SpawnKeeper (nach manueller Registrierung eintragen)
NICKSERV_PASSWORD=CHANGEME_NICKSERV_PASSWORD

# Muss identisch mit MUMBLE_SUPERUSER_PASSWORD in mumble-freespawn/.env sein.
# Der Bot verbindet sich als SuperUser, um User im AFK-Channel automatisch
# muten zu können (SuperUser umgeht alle ACLs - siehe README für den
# Sicherheits-Tradeoff dieser Entscheidung).
MUMBLE_SUPERUSER_PASSWORD=CHANGEME_SUPERUSER_PASSWORD

# Twitch-Chat nach #freespawn spiegeln ("[Twitch] USER: NACHRICHT"). Leer = aus.
# Optional TWITCH_IGNORE_USERS (Komma-Liste); Standard: gängige Bots und der Kanal selbst.
TWITCH_CHANNEL=KernicNET
